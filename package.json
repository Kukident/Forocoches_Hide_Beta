{
  "name": "forocoches-plus",
  "description": "Bloquea los hilos que no te interesen de cualquier subforo de Forocoches.",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "watch:firefox": "nodemon --watch entrypoints --watch components --watch assets --watch wxt.config.ts -e ts,vue,css,html --exec \"wxt build -b firefox --mv3\"",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.6.0",
    "@vueform/multiselect": "^2.6.11",
    "flowbite": "^4.0.1",
    "flowbite-vue": "^0.2.3",
    "lz-string": "^1.5.0",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "autoprefixer": "^10.4.27",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5",
    "wxt": "^0.20.18"
  }
}
